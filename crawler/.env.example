# ─────────────────────────────────────────────────────────────
# Lumiere Crawler — biến môi trường
#
# TÁCH BIỆT hoàn toàn với .env của API. Crawler có secret riêng để thu hồi
# độc lập được, và vì hai bên cần kiểu connection khác nhau (xem bên dưới).
# ─────────────────────────────────────────────────────────────

# ⚠️ PHẢI dùng SESSION MODE (port 5432), KHÔNG dùng transaction mode (6543).
# Importer chạy transaction dài trải nhiều câu lệnh; transaction mode không giữ
# được session xuyên suốt một cách tin cậy.
#
# DÙNG HOST POOLER, port 5432:
#   postgresql://postgres.<project-ref>:<PASSWORD>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
#                                                                                        ^^^^
#                                                                             session mode, KHÔNG phải 6543
#
# Cách nhanh nhất: copy DATABASE_URL từ .env của backend rồi ĐỔI 6543 -> 5432.
# Username của pooler có dạng `postgres.<project-ref>`, không phải `postgres`.
#
# ❌ ĐỪNG dùng direct connection `db.<project-ref>.supabase.co:5432`.
#    Supabase đã chuyển direct connection sang IPv6-only. Mạng không có IPv6 sẽ
#    báo `getaddrinfo ENOTFOUND` — hostname đó chỉ có bản ghi AAAA, không có A.
#    Pooler thì có IPv4 nên chạy được ở mọi nơi.
#
# Lấy connection string tại: Supabase Dashboard -> Connect -> Session pooler
CRAWLER_DATABASE_URL=

# debug | info | warn | error
LOG_LEVEL=info

# Định danh crawler. PHẢI có cách liên hệ — vừa là phép lịch sự, vừa là tự bảo vệ:
# IP của GitHub Actions runner là dùng chung, bị chặn thì không tự gỡ được.
CRAWLER_USER_AGENT=LumiereBot/0.1 (+https://github.com/<user>/<repo>; contact@example.com)

# Giới hạn số novel xử lý trong MỘT lần chạy (D4: 1000–5000 cho mode refresh).
CRAWL_MAX_ITEMS_PER_RUN=1000

# Rate limit lịch sự. Nâng lên là rủi ro bị chặn.
CRAWL_MAX_REQUESTS_PER_MINUTE=30
CRAWL_MAX_CONCURRENCY=2

# Crawlee dọn storage mỗi lần khởi động — bắt buộc trên CI vì thư mục là ephemeral.
CRAWLEE_PURGE_ON_START=1

# Chạy thử không ghi database.
CRAWL_DRY_RUN=false
